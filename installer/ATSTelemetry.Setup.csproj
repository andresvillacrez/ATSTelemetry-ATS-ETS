<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ATSTelemetrySetup</AssemblyName>
    <RootNamespace>ATSTelemetry.Setup</RootNamespace>
    <ApplicationIcon>..\Assets\ATSTelemetry.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <AssemblyTitle>ATS Telemetry Setup</AssemblyTitle>
    <Product>ATS Telemetry</Product>
    <Description>Instalador de ATS Telemetry</Description>
    <Company>ATS Telemetry</Company>
    <Copyright>© 2026 ATS Telemetry</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" Condition="Exists('payload.zip')" />
  </ItemGroup>

</Project>